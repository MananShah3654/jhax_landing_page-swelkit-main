    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "firebase": "^11.0.2",
