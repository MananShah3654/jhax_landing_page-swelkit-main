# Fully client-side config (PUBLIC_ vars are inlined into the browser bundle).

# Audit data source: "osm" (default, free, no key) or "google" (real Google Places).
PUBLIC_AUDIT_DATA_SOURCE="osm"
# Only needed when PUBLIC_AUDIT_DATA_SOURCE=google. Restrict by HTTP referrer!
PUBLIC_GOOGLE_PLACES_API_KEY=""

# Firebase project config (public by design; secured via firestore.rules).
PUBLIC_FIREBASE_API_KEY=""
PUBLIC_FIREBASE_AUTH_DOMAIN=""
PUBLIC_FIREBASE_DATABASE_URL=""
PUBLIC_FIREBASE_PROJECT_ID=""
PUBLIC_FIREBASE_STORAGE_BUCKET=""
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
PUBLIC_FIREBASE_APP_ID=""

# Server-only (NOT public — never prefixed, never sent to the browser).
# Powers the "What JHAX Found" findings via the auditFindings function.
# Without it the teaser still renders: score, sub-scores and listing data are
# unaffected and only the findings panel degrades.
# In production this comes from Secret Manager:
#   firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY=""
 